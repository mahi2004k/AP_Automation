# Copy this file's values into real environment variables before running the
# backend (Spring Boot does NOT read .env files automatically — see README.md
# for how to export these on Windows/Mac/Linux, or how to use a
# application-local.properties override instead).

# ---- PostgreSQL ----
DB_URL=jdbc:postgresql://localhost:5432/ap_automation_db
DB_USERNAME=postgres
DB_PASSWORD=change-me

# ---- JWT ----
# Generate your own secret, e.g.: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-base64-string
JWT_EXPIRATION=86400000

# ---- Mail (optional) ----
# Only needed if you want approval/rejection/payment emails to actually send.
# For Gmail, use an "App Password", not your normal password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ---- Server ----
SERVER_PORT=8080
