# Copy to .env in this same folder (next to docker-compose.yml) and edit.
# docker-compose automatically reads a file named ".env" in this directory.

DB_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-base64-string
JWT_EXPIRATION=86400000

# Optional — leave blank to disable email notifications
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Must be reachable from your browser (usually just localhost + the
# published port), not the internal Docker network name.
VITE_API_BASE_URL=http://localhost:8080
